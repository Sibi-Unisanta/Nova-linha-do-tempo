<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Histórico SIBi-Unisanta</title>
<style>
:root{--navy:#082b59;--blue:#0d5cab;--sky:#dceeff;--ink:#19324d;--gold:#d9a441;--paper:#fff;--muted:#60748b}
*{box-sizing:border-box}body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;color:var(--ink);background:#f4f8fc;line-height:1.6}.hero{padding:72px 6vw 84px;background:radial-gradient(circle at 85% 15%,#2d84cf 0 12%,transparent 35%),linear-gradient(135deg,#061d3d,#0d5cab 60%,#1592cf);color:white}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:.76rem;font-weight:800;color:#bfe3ff}.hero h1{font-family:Georgia,serif;font-size:clamp(2.5rem,6vw,5.5rem);line-height:1.02;max-width:850px;margin:18px 0}.hero p{max-width:720px;font-size:1.12rem;color:#e2f1ff}.note{margin-top:26px;display:inline-block;padding:10px 14px;border:1px solid #8bc9f1;border-radius:999px;color:#e9f7ff;background:#ffffff16;font-size:.9rem}.wrap{max-width:1120px;margin:0 auto;padding:58px 22px 100px}.intro{display:grid;grid-template-columns:1.2fr .8fr;gap:28px;align-items:stretch;margin-bottom:46px}.intro-card,.legend{background:var(--paper);border:1px solid #d9e5f0;border-radius:22px;padding:28px;box-shadow:0 12px 35px #0b3b6710}.intro-card h2{font-family:Georgia,serif;color:var(--navy);font-size:1.85rem;margin:0 0 10px}.legend{background:linear-gradient(145deg,#e9f5ff,#fff)}.legend strong{color:var(--navy)}.timeline{position:relative}.timeline:before{content:"";position:absolute;left:32px;top:8px;bottom:8px;width:4px;background:linear-gradient(#9ecff4,var(--blue),#08346a);border-radius:4px}.item{position:relative;padding-left:88px;margin:0 0 22px}.dot{position:absolute;left:19px;top:24px;width:30px;height:30px;border-radius:50%;background:white;border:7px solid var(--blue);box-shadow:0 0 0 5px #d1eaff;z-index:2}.year{width:max-content;min-width:86px;text-align:center;border:0;border-radius:999px;background:var(--navy);color:white;font-weight:800;padding:7px 15px;cursor:pointer;letter-spacing:.04em}.year:hover,.year:focus-visible{background:var(--blue);outline:3px solid #9cd4fa}.card{background:white;border:1px solid #d8e5f0;border-radius:20px;padding:20px 22px;box-shadow:0 10px 24px #0b3b670d}.card h3{color:var(--navy);font-family:Georgia,serif;font-size:1.45rem;line-height:1.2;margin:13px 0 8px}.meta{font-size:.78rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);font-weight:800}.details{display:none;margin-top:18px;padding-top:18px;border-top:1px solid #e4edf5}.item.open .details{display:block}.details p{margin:0;color:#435c74}.details img{display:block;width:100%;max-height:330px;object-fit:cover;border-radius:14px;margin:0 0 17px;border:1px solid #d7e3ee}.details img.doc{object-fit:contain;background:#f8fafc}.caption{font-size:.83rem;color:var(--muted);margin-top:-10px;margin-bottom:16px}.ana{color:#b17d00;background:#fff3c9;border-radius:5px;padding:0 4px;font-weight:800}.tag{display:inline-block;margin-top:16px;font-size:.76rem;border-radius:999px;padding:5px 10px;background:#e7f3fe;color:#0d5cab;font-weight:800}.tag.retro{background:#f7ead0;color:#8a5f12}.footer{background:#061d3d;color:#d8eaff;padding:30px 6vw;text-align:center;font-size:.9rem}.small{font-size:.88rem;color:var(--muted)}@media(max-width:760px){.hero{padding:54px 22px 62px}.intro{grid-template-columns:1fr}.wrap{padding-top:38px}.item{padding-left:68px}.timeline:before{left:25px}.dot{left:12px;width:28px;height:28px}.card{padding:17px}.card h3{font-size:1.22rem}}
</style>
</head>
<body>
<header class="hero"><div class="eyebrow">Memória, pesquisa e inovação</div><h1>Histórico SIBi-Unisanta</h1><p>Uma linha do tempo editorial da trajetória das Bibliotecas da Universidade Santa Cecília, organizada a partir da segunda edição do e-book institucional fornecido.</p><div class="note">Clique em cada data para abrir a foto, o documento e o texto do marco.</div></header>
<main class="wrap"><section class="intro"><article class="intro-card"><h2>Um legado construído por muitas mãos</h2><p>Da Escola Primária Santa Cecília ao Sistema Integrado de Bibliotecas, esta edição reúne os marcos históricos, acadêmicos, tecnológicos e culturais descritos no e-book.</p><p class="small"><strong>Nota editorial:</strong> os marcos desta versão foram reorganizados cronologicamente. Quando o e-book não apresenta uma data exata, o período é indicado de forma aproximada. As imagens sem correspondência digital ainda podem ser acrescentadas futuramente.</p></article><aside class="legend"><p><strong>Como ler</strong></p><p><span class="tag">Documentado no e-book</span> reúne fatos, referências e materiais citados na publicação.</p><p><span class="tag retro">Memória visual</span> identifica fotos ou documentos históricos.</p><p><strong>Ana Maria</strong> aparece destacada sempre que mencionada.</p></aside></section><section class="timeline" id="timeline" aria-label="Linha do tempo histórica"></section></main>
<footer class="footer">SIBi-Unisanta · Sistema Integrado de Bibliotecas da Universidade Santa Cecília</footer>
<script>
const events=[
['1932','Fundação da Escola Primária Santa Cecília','A origem institucional remonta à Escola Primária Santa Cecília, fundada em maio de 1932 e instalada no chamado Casarão Amarelo.','', 'Documentado no e-book'],
['1961','A Família Teixeira assume a escola','Dr. Milton Teixeira, Nilza Pirilo Teixeira e Emília Maria Pirilo assumem a instituição e iniciam uma fase de expansão educacional. O e-book registra a primeira doação de livros à biblioteca nascente, incluindo uma Bíblia Sagrada com dedicatória do Dr. Milton Teixeira.','', 'Documentado no e-book'],
['1966','Transferência do Ginásio Santa Cecília','O Ginásio Santa Cecília é transferido para a Rua Luiz de Camões, 22.','', 'Documentado no e-book'],
['1967','Criação do Lar Infantil Santa Rita de Cássia','É criado o Lar Infantil Santa Rita de Cássia, voltado a crianças em situação de vulnerabilidade, com oferta de alimentos e bolsas de estudo.','', 'Documentado no e-book'],
['1969','Criação do ISESC e registro do prédio da futura Unisanta','O Instituto Superior de Educação Santa Cecília amplia o compromisso com ensino, cultura e conhecimento. O e-book também registra o prédio da Rua Oswaldo Cruz, 266, unidade do Colégio Santa Cecília, antigo Monte Serrat.','', 'Documentado no e-book'],
['1971','Primeiro curso superior','Início do curso de Engenharia Operacional, apresentado no e-book como o primeiro curso superior da instituição e um dos primeiros cursos superiores noturnos da região.','', 'Documentado no e-book'],
['1973','Artes Plásticas e fundações do Bloco C','Criação do curso de Artes Plásticas, além do registro da primeira etapa das fundações do Bloco C.','', 'Documentado no e-book'],
['1975','Expansão de cursos técnicos e de graduação','São registrados a Licenciatura em Matemática e cursos técnicos de Mecânica, Eletrônica, Química, Magistério e Laboratorista de Análises Clínicas.','', 'Documentado no e-book'],
['1976','Pós-graduação, pesquisa, extensão e Engenharia Civil','Começam as atividades da Diretoria de Pós-Graduação, Pesquisa e Extensão, com o curso de Engenharia de Segurança do Trabalho. O e-book também registra Engenharia Civil.','', 'Documentado no e-book'],
['1977','Início da trajetória de Ana Maria','Ana Maria Raccioppi Silveira inicia sua trajetória nas bibliotecas da Unisanta. O e-book relaciona sua atuação a 48 anos de dedicação à instituição, entre 1977 e 2025.','', 'Documentado no e-book'],
['1978–1979','Transformações dos cursos','A Engenharia Operacional é transformada em Engenharia Industrial Elétrica e Engenharia Industrial Mecânica. Em 1979, é registrada a autorização para curso de formação profissionalizante básica.','', 'Documentado no e-book'],
['Década de 1980','Consolidação dos espaços bibliotecários','O e-book apresenta uma fotografia da biblioteca na década de 1980 e registra a construção do Bloco M em 1989.','', 'Documentado no e-book'],
['1992','Biblioteca Martins Fontes em destaque','Matéria de A Tribuna destaca o esforço de educadores para resgatar o hábito da leitura e informa que a biblioteca atendia cerca de 12 mil frequentadores mensais.','', 'Documentado no e-book'],
['1996','Desmembramento institucional e nome Unisanta','Em 23 de fevereiro de 1996, o Ministério da Educação e do Desporto autoriza o desmembramento da antiga Universidade Santa Cecília dos Bandeirantes. A instituição passa a usar o nome Unisanta — Universidade Santa Cecília.','', 'Documentado no e-book'],
['1997','Solicitação de implantação do WINISIS','Ana Maria R. Silveira e Carmen Vera de Boer Guidoni solicitam a implantação do software WINISIS para otimizar o gerenciamento do acervo e dos serviços.','', 'Documentado no e-book'],
['1997','Carta sobre a informatização das bibliotecas','Em carta, Ana Maria reforça a urgência da modernização e menciona que os computadores existentes eram processadores 286 muito antigos, limitando o acesso eficiente à informação.','', 'Documentado no e-book'],
['1998','Novo edifício e avanço da informatização','É inaugurado o Edifício Arquiteto Aníbal Martins Clemente, que passa a abrigar a biblioteca. O período também é associado à expansão do catálogo e dos serviços digitais.','data:image/jpeg;base64,','Memória visual'],
['2001','Jornal do SIBI e ampliação da estrutura','O lançamento do Jornal do SIBI — Unisanta anuncia a ampliação das bibliotecas. O e-book descreve 84.124 volumes, 1.600 periódicos, 1.500 m², Biblioteca Central e Biblioteca da Saúde, além de acervo informatizado e acesso por terminais e internet.','', 'Documentado no e-book'],
['2002–2003','Comunicação institucional','O e-book referencia novas edições do Jornal do SIBI e matéria de A Tribuna sobre as bibliotecas.','', 'Documentado no e-book'],
['2008','Lançamento do livro Viva Pagu','Registro do lançamento do livro Viva Pagu, com a presença das bibliotecárias Cibele Araujo e <span class="ana">Ana Maria</span>.','data:image/jpeg;base64,','Memória visual'],
['2010','Implantação da Biblioteca Virtual Pearson','A biblioteca amplia o acesso a uma base de dados multidisciplinar da Pearson.','', 'Documentado no e-book'],
['2011','BNweb e programação cultural','A equipe recebe certificados do sistema BNweb. O e-book também registra atividades como Sarau entre Livros, Conexão Cultural e a presença de <span class="ana">Ana Maria</span> e equipe no Cineclube Lanterna Mágica.','', 'Documentado no e-book'],
['2013','Base EBSCO','Criação da Base de Dados e Periódicos Científicos da EBSCO, de caráter multidisciplinar.','', 'Documentado no e-book'],
['2014','Parcerias digitais e documentação histórica','O e-book registra parceria com a Editora Saraiva e a Faculdade de Direito para acesso à biblioteca digital. Também referencia matéria sobre a reestruturação do Centro de Documentação Histórica de Santos.','data:image/jpeg;base64,','Memória visual'],
['2015','Centro de Documentação Histórica de Santos — CDHS','O CDHS é apresentado como espaço para reunir, preservar, divulgar e valorizar obras de escritores da Baixada Santista. O acervo é descrito com 327 títulos e coleções como Família Teixeira, Martins Fontes, Rui Ribeiro Couto e Literatura.','data:image/jpeg;base64,','Memória visual'],
['2016','Homenagem a Ana Maria','Em 19 de novembro de 2016, <span class="ana">Ana Maria Raccioppi Silveira</span> recebe o Diploma de Honra ao Mérito durante as celebrações dos 55 anos do Complexo Educacional Santa Cecília.','', 'Documentado no e-book'],
['2016','Revista dos Tribunais On-line','Implantação do acesso à plataforma Revista dos Tribunais On-line.','', 'Documentado no e-book'],
['2018','Comunicação por WhatsApp','A Biblioteca passa a utilizar o WhatsApp para comunicação com usuários e é destacada em publicação da área de Biblioteconomia.','', 'Documentado no e-book'],
['2019','Feira do Livro e 20 anos do Cineclube','Participação na Feira do Livro e celebração dos 20 anos do Cineclube Lanterna Mágica.','', 'Documentado no e-book'],
['2020–2025','Continuidade, formação e legado','As bibliotecas ampliam o acesso a bibliotecas virtuais e bases científicas, capacitam a comunidade para o uso de tecnologias e metodologias de pesquisa e consolidam o legado de <span class="ana">Ana Maria</span> ao longo de 48 anos.','', 'Documentado no e-book']
];
const root=document.querySelector('#timeline');
for(const [year,title,text,image,status] of events){const item=document.createElement('article');item.className='item';const dot=document.createElement('span');dot.className='dot';const card=document.createElement('div');card.className='card';const button=document.createElement('button');button.className='year';button.type='button';button.setAttribute('aria-expanded','false');button.textContent=year;const h=document.createElement('h3');h.innerHTML=title;const meta=document.createElement('div');meta.className='meta';meta.textContent='Marco histórico';const details=document.createElement('div');details.className='details';if(image){const img=document.createElement('img');img.src=image;img.alt='Imagem relacionada a '+title;if(image.includes('Documentos'))img.className='doc';details.appendChild(img);const cap=document.createElement('div');cap.className='caption';cap.textContent='Imagem/documento fornecido no e-book ou no acervo enviado.';details.appendChild(cap)}const p=document.createElement('p');p.innerHTML=text;details.appendChild(p);const tag=document.createElement('span');tag.className='tag '+(status==='Memória visual'?'retro':'');tag.textContent=status;details.appendChild(tag);button.addEventListener('click',()=>{const open=item.classList.toggle('open');button.setAttribute('aria-expanded',open?'true':'false')});card.append(button,meta,h,details);item.append(dot,card);root.appendChild(item)}
</script>
</body>
</html>
